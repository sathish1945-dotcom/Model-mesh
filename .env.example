# Canonical deployed URL, used for OAuth callbacks. Must match the Google Console redirect URI.
APP_URL="https://your-modelmesh-domain.example"

# AUTH_SECRET: Secret key used to sign and verify application session JWTs/cookies
AUTH_SECRET="replace-with-a-new-random-secret"

# APP_ENCRYPTION_KEY: Base64-encoded 32-byte (256-bit) AES key for server-side AES-256-GCM encryption
# Generate via: openssl rand -base64 32
APP_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

# Google OAuth web client ID for Drive consent; client secret stays server side.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required for production. Apply migrations 001, 002, and 003 in order first.
DATABASE_URL=""
